# Copy to a private file outside the build context, for example /etc/konterkuota/production.env.
DB_USER=konter_prod_user
DB_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PUBLIC_ORIGIN=https://example.com
TLS_CERT_DIR=/etc/letsencrypt/live/example.com
RELEASE_TAG=REPLACE_WITH_IMMUTABLE_RELEASE_ID
