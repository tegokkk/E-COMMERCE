# KonterKuota - Backend Environment Variables
PORT=4000
DATABASE_URL=postgresql://konter_user:CHANGE_ME@127.0.0.1:5432/konterkuota
TEST_DATABASE_URL=postgresql://konter_user:CHANGE_ME@127.0.0.1:5432/konterkuota_test
SESSION_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
DEVELOPMENT_ADMIN_PASSWORD=CHANGE_ME_USE_12_OR_MORE_CHARACTERS
PUBLIC_ORIGIN=http://localhost:3000
TRUST_PROXY=false
DISPLAY_TIME_ZONE=Asia/Jakarta
IMAGE_ALLOWED_HOSTS=lh3.googleusercontent.com,images.unsplash.com
# Opsional: direktori persisten untuk foto; default backend/uploads
# UPLOAD_DIR=/path/ke/konterkuota-uploads
ANALYTICS_ENABLED=true
LOG_LEVEL=info
NODE_ENV=development

# Vercel: private Blob store connected to the backend project.
# UPLOAD_STORAGE=blob
# BLOB_STORE_ID=store_id_from_connected_vercel_blob
# BLOB_READ_WRITE_TOKEN=only_when_oidc_is_not_available
# CRON_SECRET=use_at_least_32_random_characters
# DATABASE_MIGRATION_URL=optional_direct_postgres_url_for_migrations
# INITIAL_ADMIN_EMAIL=admin@your-domain.id
# INITIAL_ADMIN_PASSWORD=set_a_unique_password_minimum_12_characters
# INITIAL_ADMIN_NAME=Admin KonterKuota

